generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  dni       String?  
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}